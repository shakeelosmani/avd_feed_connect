[Desktop Entry]
Type=Application
Name=AVD Feed + Connect Linux
Comment=Sign in and connect to your Azure Virtual Desktop workspaces
Exec=avd-feed-connect %u
Icon=io.github.shakeelosmani.avd_feed_connect
Terminal=false
Categories=Network;RemoteAccess;GTK;
Keywords=avd;rdp;remote;azure;virtual;desktop;windows;freerdp;
StartupNotify=true
# Registers the app as the handler for the ms-appx-web sign-in redirect so the
# browser can hand the final ?code=… URL straight back (see do_open); the %u on
# Exec passes that URI in. Flatpak exports this and routes the URI to the
# running instance over D-Bus.
MimeType=x-scheme-handler/ms-appx-web;
